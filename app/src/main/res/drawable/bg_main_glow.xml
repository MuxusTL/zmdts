<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/bg" />
    <item android:height="280dp" android:gravity="top|fill_horizontal">
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="260dp"
                android:centerX="0.5"
                android:centerY="0"
                android:startColor="#33EF4444"
                android:endColor="#000A0A0B" />
        </shape>
    </item>
</layer-list>
