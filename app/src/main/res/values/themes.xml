        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dim</item>
        <item name="colorOnPrimary">@color/text</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/primary_dim</item>
        <item name="colorOnSecondary">@color/text</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>

        <item name="android:statusBarColor">@color/bg</item>
